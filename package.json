{
  "name": "chat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.ts",
    "build": "tsc -b && vite build",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "lint": "oxlint",
    "test": "node --test \"server/tests/**/*.test.ts\"",
    "typecheck": "tsc -b --pretty",
    "verify:supabase": "node --env-file-if-exists=.env scripts/verify-supabase.mjs",
    "verify:rag": "node --env-file-if-exists=.env scripts/verify-rag.mjs",
    "verify:questions": "node --env-file-if-exists=.env scripts/verify-question-paper.mjs",
    "verify:ocr": "node scripts/verify-ocr.mjs",
    "e2e:auth": "node --env-file-if-exists=.env scripts/e2e-auth.mjs",
    "migrate:supabase": "node --env-file-if-exists=.env scripts/apply-migrations.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.13",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.61.0",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
