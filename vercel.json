{
  "framework": "vite",
  "functions": {
    "server/index.ts": {
      "runtime": "nodejs20.x"
    }
  },
  "routes": [
    {
      "source": "/api/(.*)",
      "methods": ["GET", "POST", "PUT", "DELETE", "PATCH"],
      "destination": "server/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html",
      "status": 200
    }
  ]
}