# Server (never exposed to the browser)

# Provider API key — required for chat completions.
GROQ_API_KEY=your_groq_api_key_here

# Model used when the client does not pick one explicitly.
GROQ_CHAT_MODEL=openai/gpt-oss-20b

# Optional overrides for the vision / embedding models used by later stages.
GROQ_VISION_MODEL=your_vision_model_here
GROQ_EMBED_MODEL=your_embedding_model_here

# Optional override for the OpenAI-compatible base URL.
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Port the chat API listens on. The Vite dev server proxies /api here.
PORT=3001

# Comma-separated list of origins allowed to call the API.
# APP_ORIGINS=http://localhost:5173

# Auth / persistence (used by later stages, not by the chat API yet)
JWT_SECRET=replace_with_a_long_random_value
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=replace_with_a_long_random_value

# Public (safe to ship to the browser)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
