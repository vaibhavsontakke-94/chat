# Server (never exposed to the browser)

# Provider API key — required for chat completions.
GROQ_API_KEY=your_groq_api_key_here

# Model used when the client does not pick one explicitly.
GROQ_CHAT_MODEL=openai/gpt-oss-20b

# Optional override for the vision model used by later stages.
GROQ_VISION_MODEL=your_vision_model_here

# Embeddings for document ingestion + RAG.
# local       = built-in deterministic fallback (works anywhere, including Vercel)
# ollama      = a running Ollama server (best local semantic quality)
# openai      = any OpenAI-compatible /embeddings endpoint
# huggingface = Hugging Face Inference Providers (semantic, Vercel-friendly)
# google      = Google Gemini API embeddings (semantic, Vercel-friendly)
# Auto-detected when omitted: EMBEDDINGS_API_* -> openai, HF_TOKEN/HF_EMBEDDING_MODEL
# -> huggingface, GEMINI_API_KEY/GOOGLE_API_KEY -> google, OLLAMA_* -> ollama, else local.
EMBEDDINGS_PROVIDER=local

# Hugging Face Inference Providers (used when EMBEDDINGS_PROVIDER=huggingface).
# The token must be a fine-grained token with "Make calls to Inference Providers"
# permission. Never expose this token to the browser.
# HF_TOKEN=hf_your_token_here
# HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Optional endpoint/override and batch size (max 64).
# HF_EMBEDDINGS_URL=https://router.huggingface.co/hf-inference/models/sentence-transformers/all-MiniLM-L6-v2
# HF_EMBEDDING_BATCH_SIZE=32
# MiniLM returns 384-dimension vectors. The server pads them with zeros to 768
# so they work with migrations/002_rag_pgvector.sql without a schema change.

# Google Gemini API embeddings (used when EMBEDDINGS_PROVIDER=google).
# Uses the native Gemini API (not the OpenAI-compatible endpoint). Never expose
# this key to the browser.
# GEMINI_API_KEY=your_google_ai_studio_key_here
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Optional base URL and batch size (max 100). The model is requested with 768
# output dimensions to match migrations/002_rag_pgvector.sql.
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_EMBEDDING_BATCH_SIZE=100

# OCR for scanned PDFs and PNG/JPG images. Tesseract downloads language data on
# first use and caches it locally. Use "+" for multiple languages (eng+hin).
# TESSERACT_LANG=eng
# TESSERACT_CACHE_PATH=C:\Users\you\AppData\Local\Temp\nyra-tesseract

# Ollama settings (used when EMBEDDINGS_PROVIDER=ollama).
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_EMBED_MODEL=nomic-embed-text
# Legacy alias for OLLAMA_EMBED_MODEL:
# GROQ_EMBED_MODEL=nomic-embed-text

# OpenAI-compatible embeddings (used when EMBEDDINGS_PROVIDER=openai).
# Must return 768-dimension vectors to match migrations/002_rag_pgvector.sql.
# EMBEDDINGS_API_URL=https://api.openai.com/v1/embeddings
# EMBEDDINGS_API_KEY=your_embeddings_api_key_here
# EMBEDDINGS_MODEL=text-embedding-3-small

# Optional override for the OpenAI-compatible base URL.
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Port the chat API listens on. The Vite dev server proxies /api here.
PORT=3001

# RAG tuning. Threshold is the minimum cosine similarity for a retrieved chunk.
# RAG_MAX_CONTEXT_CHUNKS limits how many chunks are sent to the LLM.
# RAG_DEBUG=true enables safe diagnostic logs (counts, ids, scores only).
# Never enable debug logging in production with sensitive user documents.
# RAG_SIMILARITY_THRESHOLD=0.2
# RAG_MAX_CONTEXT_CHUNKS=6
# RAG_DEBUG=false

# Protects the processing recovery endpoint POST /api/documents/process.
# CRON_SECRET=your_random_cron_secret

# Comma-separated list of origins allowed to call the API.
# APP_ORIGINS=http://localhost:5173

# Auth / persistence (server only - never expose these to the browser)
# Enable Anonymous Sign-ins in Supabase Auth; the app creates one automatically
# per browser instead of showing a login page.
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only. Used for the private documents bucket and is required for
# automatic bucket creation. Request data still uses the user's token + RLS.
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional: legacy local JWT verification fallback. Primary verification uses Auth.
# SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Optional: management API token for applying migrations / project setup scripts.
# Create one at https://supabase.com/dashboard/account/tokens (never expose publicly).
# SUPABASE_ACCESS_TOKEN=sbp_your_personal_access_token

# Public (safe to ship to the browser)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
